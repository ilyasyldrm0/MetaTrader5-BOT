# Copy to .env and fill in, or export these in your shell.
#
# These override the [terminal] section of the config file. Keeping them here
# rather than in config.toml means the credentials never sit in a file that
# gets committed -- .env is already in .gitignore.
#
# All four are optional. With none of them set, the bot attaches to whichever
# account the running MetaTrader 5 terminal is already logged into, which is
# the simplest and usually the right answer.

# Full path to terminal64.exe, if it is not where MetaTrader5 looks by default.
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Log in to a specific account instead of the one already open.
# MT5_LOGIN=12345678
# MT5_PASSWORD=your-password-here
# MT5_SERVER=YourBroker-Demo
